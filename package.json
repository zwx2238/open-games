{
  "name": "@local-agent-bridge/open-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "localAgentBridgeService": {
    "id": "open-games",
    "envPrefix": "OPEN_GAMES",
    "defaultPort": 3981
  },
  "scripts": {
    "catalog:generate": "node scripts/generate-games.mjs",
    "service:build": "node scripts/service-build.mjs",
    "service:serve": "node service/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "candidates:audit": "node scripts/audit-candidates.mjs",
    "visual-smoke": "node scripts/visual-smoke.mjs",
    "check": "pnpm run typecheck && pnpm run service:build && pnpm run test"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@local-agent-bridge/embedded-service-sdk": "git+ssh://git@gitee.com/wen_xiang_zou_admin/local-agent-bridge-service-sdk.git#181913254b68eaae6d72ac54e73feceda41ff362&path:packages/embedded-service-sdk",
    "@local-agent-bridge/node-sidecar-runtime": "git+ssh://git@gitee.com/wen_xiang_zou_admin/local-agent-bridge-service-sdk.git#181913254b68eaae6d72ac54e73feceda41ff362&path:packages/node-sidecar-runtime",
    "http-proxy": "^1.18.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@local-agent-bridge/embedded-service-sdk",
      "@local-agent-bridge/node-sidecar-runtime"
    ]
  }
}
